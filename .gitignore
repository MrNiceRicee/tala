# secrets - api keys and tool credentials
.env
.env.local
.env.*.local

# dependencies
node_modules/

# obsidian config
.obsidian/

# internal dev lifecycle docs (specs, brainstorms, planning)
docs/

# os
.DS_Store
Thumbs.db

# editor
*.swp
*.swo
*~
.vscode/
.idea/

# personal research content - stays local, not part of the tool
topics/*
!topics/.gitkeep
sketch/*
!sketch/.gitkeep
archive/*
!archive/.gitkeep
!archive/README.md

# personal tools (reusable scripts across topics)
tools/*
!tools/.gitkeep
!tools/README.md

# HTTP cache (keyed by url+body hash; speeds up repeated tool runs, preserves API quota)
.cache/
