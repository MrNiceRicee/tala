# API keys for tools. Copy this file to `.env` and fill in your values.
# The `.env` file is gitignored.
#
# Only set keys for tools you actually use. Tools that need a key will tell
# you if it's missing.

# Travel / maps (used by drive-matrix and similar tools)
OPENROUTESERVICE_API_KEY=
HERE_API_KEY=

# Add new keys here as your tools need them.
